# Скопируйте этот файл в config/.env и заполните.

# ID Google Таблицы: часть ссылки между /d/ и /edit
# https://docs.google.com/spreadsheets/d/ВОТ_ЭТО_ID/edit
SPREADSHEET_ID=

# Путь к JSON-ключу сервисного аккаунта (относительно корня проекта или абсолютный)
GOOGLE_KEY_PATH=config/service_account.json

# Альтернатива пути: всё содержимое JSON-ключа одной строкой (удобно для облака/CI)
# GOOGLE_SA_JSON=

# --- Необязательные переопределения API наш.дом.рф ---
# Заполняйте, только если discover_api.py показал другие адреса/параметры.
# NASHDOM_API_LIST=https://xn--80az8a.xn--d1aqf.xn--p1ai/сервисы/api/kn/object
# NASHDOM_API_OBJECT=https://xn--80az8a.xn--d1aqf.xn--p1ai/сервисы/api/object/{id}
# NASHDOM_API_DECLARATION=
# Доп. параметры списка в JSON, например фильтр по городу:
# NASHDOM_EXTRA_PARAMS={"cityId": "..."}
# Путь к своему Chromium, если `playwright install` недоступен (необязательно)
# CHROMIUM_PATH=/opt/pw-browsers/chromium
